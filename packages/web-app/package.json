{
  "name": "voyager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@sentry/vue": "^10.69.0",
    "dexie": "^4.0.11",
    "lucide-vue-next": "^1.0.0",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^5.3.0",
    "pinia": "^2.3.0",
    "qrcode.vue": "^3.9.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.5.0",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
